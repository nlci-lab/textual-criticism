---
// Manuscript comparison for one verse, from CNTR transcriptions (CC BY-SA 4.0).
// Two views of the same alignment, switched by a toggle:
//   "By reading": each variation unit as a card, witnesses grouped under their reading (default).
//   "Word by word": every witness word under the base word, in short phrases that wrap.
// Without JavaScript both views show, one after the other.
import Word from './CollWord.astro';
import Sig from './SiglumCard.astro';
import { rows as buildRows, readings, siglum, ortho, type UnitDef, type Witness, type MsWord, type Kind, type Row } from '../lib/collate';
import { translit, translitMs } from '../lib/translit';
interface Props {
  verse: { ref: string; id: string };
  data: { witnesses: Record<string, string | null>; source: string; credit: string; licence: string };
  base: [string, string][];
  english: string;
  witnesses: Witness[];
  units: UnitDef[];
  phrases: [number, number][];
  glosses?: Record<string, string>;
}
const { verse, data, base, english, witnesses, units, phrases, glosses = {} } = Astro.props;
const baseWords = base.map(([g]) => g);
const rs = buildRows(baseWords, witnesses, data.witnesses);
// Show a corrected row only where the corrector changed something.
const shown = rs.filter((r) => {
  if (r.hand === 'first') return true;
  const f = rs.find((x) => x.w.id === r.w.id && x.hand === 'first')!;
  return JSON.stringify(r.al.slots.map((s) => s.word?.ortho)) !== JSON.stringify(f.al.slots.map((s) => s.word?.ortho))
    || JSON.stringify([...r.al.adds]) !== JSON.stringify([...f.al.adds]);
});
// Printed editions (optional Witness.kind) go after the manuscripts, in lower case, with no page link.
const isEd = (w: Witness) => (w as Witness & { kind?: string }).kind === 'edition';
shown.sort((a, b) => +isEd(a.w) - +isEd(b.w));
const firstEd = shown.findIndex((r) => isEd(r.w));
const label = (r: Row) => r.w.siglum + (shown.some((x) => x.w.id === r.w.id && x.hand !== r.hand) ? (r.hand === 'first' ? '*' : 'ᶜ') : '');
const vref = `John ${verse.ref.split(' ')[1] ?? verse.ref}`;
/** Transliterate manuscript words, borrowing breathings from the base word each one matches (in the unit first). */
const tlWords = (ws: MsWord[], u?: UnitDef) => ws.map((w) => {
  const near = u ? baseWords.slice(Math.max(0, u.from - 1), u.to + 2) : [];
  const b = [...near, ...baseWords].find((g) => ortho(g) === w.ortho);
  return translitMs(w.norm, b);
}).join(' ');
const unitAt = (k: number) => units.findIndex((u) => u.from <= u.to && k >= u.from && k <= u.to);
const cls: Record<Kind, string> = { same: '', spelling: 'sp', different: 'sub', missing: 'om', added: 'add', order: 'tr' };
const glossOf = (w: MsWord) => glosses[w.norm];
// The base verse in runs: consecutive words of the same unit share one highlight.
const runs: { u: number; words: string[] }[] = [];
baseWords.forEach((g, k) => { const u = unitAt(k); const last = runs[runs.length - 1]; if (last && last.u === u) last.words.push(g); else runs.push({ u, words: [g] }); });

/** Columns of one phrase: words added before it, then each base word with words added after it inside the phrase. */
function columns([s, e]: [number, number]) {
  const cols: ({ t: 'base'; k: number } | { t: 'add'; k: number })[] = [];
  const hasAdd = (k: number) => shown.some((r) => (r.al.adds.get(k) ?? []).length);
  if (hasAdd(s - 1)) cols.push({ t: 'add', k: s - 1 });
  for (let k = s; k <= e; k++) {
    cols.push({ t: 'base', k });
    if ((k < e || k === base.length - 1) && hasAdd(k)) cols.push({ t: 'add', k });
  }
  return cols;
}
---
<section class="coll" data-coll aria-labelledby={`coll-${verse.id}`}>
<details class="coll-fold" open>
  <summary><h3 id={`coll-${verse.id}`}>See it in the manuscripts</h3></summary>
  <div class="coll-head" hidden>
    <div class="coll-toggle" role="group" aria-label="View">
      <button type="button" data-view="reading" aria-pressed="true">By reading</button>
      <button type="button" data-view="grid" aria-pressed="false">Word by word</button>
    </div>
    <button type="button" class="coll-tl-btn" data-tl-btn aria-pressed="true">Transliteration</button>
  </div>
  <p class="coll-key small">
    <span><i class="sw sub"></i>different word</span><span><i class="sw add"></i>added</span><span><i class="sw tr"></i>changed order</span>
    <span>— missing</span><span><span class="sp">greyed</span> spelling only</span><span><span class="g ns">θσ</span> sacred name, shortened</span>
    <span><span class="g dmg">ο</span> damaged</span><span><span class="g miss">υ</span> lost, restored</span>
  </p>

  <!-- By reading -->
  <div class="coll-view" data-v="reading">
    <p class="coll-base g">{runs.map((run, i) => <>{run.u >= 0 ? <mark>{run.words.join(' ')}</mark> : run.words.join(' ')}{i < runs.length - 1 ? ' ' : '.'}</>)}</p>
    <p class="tl coll-tl" lang="grc-Latn">{translit(baseWords.join(' '))}.</p>
    <p class="coll-eng">{english}</p>
    <div class="units">
      {units.map((u, n) => {
        const rds = readings(baseWords, rs.filter((r) => shown.includes(r)), u);
        return (
          <article class="unit">
            <h4><span class="un">{n + 1}</span> <span class="g">{u.label}</span>{u.note && <span class="muted"> · {u.note}</span>}</h4>
            <div class="rds">
              {rds.map((rd) => (
                <div class="rd">
                  <p class="form g">{rd.words.length ? rd.words.map((w, i) => <><Word w={w} lower={rd.rows.every((r) => isEd(r.w))} />{i < rd.words.length - 1 ? ' ' : ''}</>) : <span class="om">{u.from > u.to ? 'nothing added' : '— omits'}</span>}</p>
                  {rd.words.length > 0 && <p class="tl" lang="grc-Latn">{tlWords(rd.words, u)}</p>}
                  <p class="eng">{rd.gloss ? (rd.words.length ? `“${rd.gloss}”` : rd.gloss) : ''}{rd.isBase && <span class="ubs">UBS text</span>}</p>
                  <ul class="wits">
                    {rd.rows.filter((r) => !isEd(r.w)).map((r) => (
                      <li>
                        <Sig w={r.w} text={siglum(r, rs, u)} verseId={verse.id} verseRef={vref} />
                        <span class="dt">{r.w.date}</span>
                      </li>
                    ))}
                  </ul>
                  {rd.rows.some((r) => isEd(r.w)) && <p class="eds"><span class="eds-h">Printed editions</span> {rd.rows.filter((r) => isEd(r.w)).map((r, i, a) => <><span class="ed-sg" title={r.w.label}>{r.w.siglum}</span>{i < a.length - 1 ? ', ' : ''}</>)}</p>}
                </div>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- Word by word -->
  <div class="coll-view" data-v="grid">
    {phrases.map((ph, pi) => {
      const cols = columns(ph);
      const cellFor = (r: Row, c: (typeof cols)[number]) => {
        if (c.t === 'add') {
          const a = r.al.adds.get(c.k) ?? [];
          return <div class="cell g" role="cell">{a.map((x, i) => <><span class={cls[x.kind]}><Word w={x.word} lower={isEd(r.w)} /></span>{i < a.length - 1 ? ' ' : ''}</>)}{a.some((x) => glossOf(x.word)) && <span class="gl"> {a.map((x) => glossOf(x.word)).filter(Boolean).join(' ')}</span>}</div>;
        }
        const s = r.al.slots[c.k];
        return s.word
          ? <div class="cell g" role="cell"><span class={cls[s.kind]}><Word w={s.word} lower={isEd(r.w)} /></span>{s.kind === 'different' && glossOf(s.word) && <span class="gl"> {glossOf(s.word)}</span>}</div>
          : <div class="cell" role="cell"><span class="om" title={s.kind === 'order' ? 'moved: see the added column' : 'missing'}>{s.kind === 'order' ? '↔' : '—'}</span></div>;
      };
      return (
        <div class="blk" role="table" aria-label={`Phrase ${pi + 1} of ${phrases.length}`} style={`--cols:${cols.length}`}>
          <div class="row" role="row">
            <div class="cell head lab" role="columnheader"><span class="small muted">Phrase {pi + 1}</span><span class="gl">English</span></div>
            {cols.map((c) => <div class:list={['cell head', { var: c.t === 'add' || unitAt(c.k) >= 0 }]} role="columnheader">
              {c.t === 'base' ? <><span class="g hb">{base[c.k][0]}</span><span class="tl" lang="grc-Latn">{translit(base[c.k][0])}</span><span class="gl">{base[c.k][1]}</span></> : <><span class="g hb">+</span><span class="gl">added</span></>}
            </div>)}
          </div>
          {shown.map((r, ri) => (
            <>
              {ri === firstEd && <div class="row" role="row"><div class="cell grp" role="cell">Printed editions</div></div>}
              <div class:list={['row', { ed: isEd(r.w) }]} role="row">
                <div class="cell lab" role="rowheader">{isEd(r.w) ? <span class="ed-sg" title={r.w.label}>{label(r)}</span> : <Sig w={r.w} text={label(r)} verseId={verse.id} verseRef={vref} />}</div>
                {cols.map((c) => cellFor(r, c))}
              </div>
            </>
          ))}
        </div>
      );
    })}
  </div>

  <p class="coll-credit small muted">Manuscript text: transcriptions by Alan Bunning, <a href={data.source}>Center for New Testament Restoration</a>, {data.licence}. Lined up and glossed by this site; this comparison is also {data.licence}. Point at or tap a manuscript's siglum for details; click it to see its page at CNTR. Manuscript words are shown in capitals as written. Printed editions (Byzantine text of Robinson–Pierpont, Textus Receptus, Westcott–Hort, CNTR's SR) come from the same CNTR files.</p>
</details>
  <dialog class="cntr-dialog" data-page-dialog aria-label="CNTR page view">
    <div class="cntr-bar">
      <strong class="small" data-page-title>CNTR</strong>
      <a class="small" data-page-new href="https://greekcntr.org/manuscripts/" target="_blank" rel="noopener">Open in new tab ↗<span class="vh"> (opens in a new tab)</span></a>
      <button type="button" class="cntr-close">Close</button>
    </div>
    <iframe title="CNTR page view"></iframe>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-coll]').forEach((root) => {
    const head = root.querySelector<HTMLElement>('.coll-head')!;
    const btns = [...head.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const views = [...root.querySelectorAll<HTMLElement>('.coll-view')];
    head.hidden = false;
    root.classList.add('js');
    function set(v: string) {
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      views.forEach((el) => (el.hidden = el.dataset.v !== v));
      try { localStorage.setItem('coll-view', v); } catch {}
    }
    btns.forEach((b) => b.addEventListener('click', () => set(b.dataset.view!)));
    let start = 'reading';
    try { start = localStorage.getItem('coll-view') === 'grid' ? 'grid' : 'reading'; } catch {}
    const q = new URLSearchParams(location.search).get('view');   // ?view=grid links straight to the word-by-word view
    if (q === 'grid' || q === 'reading') start = q;
    set(start);

    // Transliteration on/off (default on).
    const tlBtn = head.querySelector<HTMLButtonElement>('[data-tl-btn]')!;
    function setTl(on: boolean) {
      tlBtn.setAttribute('aria-pressed', String(on));
      root.classList.toggle('tl-off', !on);
      try { localStorage.setItem('coll-tl', on ? 'on' : 'off'); } catch {}
    }
    tlBtn.addEventListener('click', () => setTl(tlBtn.getAttribute('aria-pressed') !== 'true'));
    let tl = true;
    try { tl = localStorage.getItem('coll-tl') !== 'off'; } catch {}
    setTl(tl);

    // CNTR page dialog, shared by every siglum in this comparison.
    const dlg = root.querySelector<HTMLDialogElement>('[data-page-dialog]')!;
    const frame = dlg.querySelector('iframe')!;
    const newTab = dlg.querySelector<HTMLAnchorElement>('[data-page-new]')!;
    const title = dlg.querySelector<HTMLElement>('[data-page-title]')!;
    dlg.querySelector('.cntr-close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    function openPage(a: HTMLAnchorElement, e: MouseEvent) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1 || !('showModal' in dlg)) return;   // let the browser open a tab
      e.preventDefault();
      hideCard();
      const href = a.dataset.page!;
      if (frame.getAttribute('src') !== href) frame.src = href;
      newTab.href = href;
      title.textContent = 'CNTR · ' + (a.dataset.title ?? '');
      dlg.setAttribute('aria-label', 'CNTR page view: ' + (a.dataset.title ?? ''));
      dlg.showModal();
    }

    // Siglum details cards: hover, focus or first tap shows; Esc, tap outside or leaving hides.
    let open: { wrap: HTMLElement; card: HTMLElement } | null = null;
    let timer = 0;
    function hideCard() { clearTimeout(timer); if (open) { open.card.hidden = true; open.wrap.classList.remove('on'); open = null; } }
    function place(btn: HTMLElement, card: HTMLElement) {
      const r = btn.getBoundingClientRect(), vw = document.documentElement.clientWidth;
      const w = Math.min(card.offsetWidth, vw - 16);
      card.style.left = Math.max(8, Math.min(r.left, vw - w - 8)) + 'px';
      const below = r.bottom + 6, h = card.offsetHeight;
      card.style.top = (below + h > innerHeight - 8 && r.top - h - 6 > 8 ? r.top - h - 6 : below) + 'px';
    }
    function showCard(wrap: HTMLElement) {
      clearTimeout(timer);
      if (open?.wrap === wrap) return;
      hideCard();
      const card = wrap.querySelector<HTMLElement>('.sg-card')!;
      card.hidden = false;
      wrap.classList.add('on');
      place(wrap.querySelector('.sg-btn')!, card);
      open = { wrap, card };
    }
    const hover = matchMedia('(hover: hover)');
    root.querySelectorAll<HTMLElement>('[data-sgw]').forEach((wrap) => {
      const btn = wrap.querySelector<HTMLAnchorElement>('.sg-btn')!;
      let touch = false;
      btn.setAttribute('aria-haspopup', 'dialog');
      btn.setAttribute('aria-label', btn.getAttribute('aria-label')!.replace('(opens in a new tab)', '(opens a page view)'));
      wrap.addEventListener('mouseenter', () => { if (hover.matches) showCard(wrap); });
      wrap.addEventListener('mouseleave', () => { if (hover.matches && open?.wrap === wrap) timer = window.setTimeout(hideCard, 250); });
      btn.addEventListener('pointerdown', (e) => { touch = e.pointerType !== 'mouse'; });
      btn.addEventListener('focus', () => showCard(wrap));
      wrap.addEventListener('focusout', (e) => { if (!wrap.contains(e.relatedTarget as Node)) { if (open?.wrap === wrap) hideCard(); } });
      btn.addEventListener('click', (e) => {
        // A tap first shows the card; a second tap (or the card's page link) opens the page.
        if (touch && open?.wrap !== wrap) { e.preventDefault(); showCard(wrap); touch = false; return; }
        touch = false;
        openPage(btn, e);
      });
      wrap.querySelector<HTMLAnchorElement>('.sg-pagelink')?.addEventListener('click', (e) => openPage(e.currentTarget as HTMLAnchorElement, e));
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open && !dlg.open) hideCard(); });
    document.addEventListener('pointerdown', (e) => { if (open && !open.wrap.contains(e.target as Node)) hideCard(); });
    addEventListener('scroll', () => { if (open) place(open.wrap.querySelector('.sg-btn')!, open.card); }, { passive: true });
    root.querySelectorAll('.blk').forEach((b) => b.addEventListener('scroll', hideCard, { passive: true }));
    addEventListener('resize', hideCard);
  });
</script>

<style>
  .coll { margin: 1.5rem 0; padding: 1rem 1.1rem 1.1rem; border: 1px solid var(--rule); border-radius: 12px; background: var(--paper); }
  .coll-fold > summary { cursor: pointer; display: flex; align-items: center; gap: .5rem; list-style: none; }
  .coll-fold > summary::-webkit-details-marker { display: none; }
  .coll-fold > summary::before { content: ""; width: .5rem; height: .5rem; border-right: 2px solid var(--ink-2); border-bottom: 2px solid var(--ink-2); transform: rotate(-45deg); transition: transform .15s; flex: none; margin: 0 .2rem; }
  .coll-fold[open] > summary::before { transform: rotate(45deg); }
  .coll-fold > summary h3 { margin: 0; font-size: 1.15rem; }
  .coll-head { display: flex; flex-wrap: wrap; gap: .5rem .75rem; align-items: center; margin-top: .6rem; }
  .coll-head[hidden] { display: none; }
  .coll-tl-btn { border: 1px solid var(--ink); border-radius: 999px; background: var(--paper); color: var(--ink); padding: .4rem .9rem; min-height: 2.25rem; cursor: pointer; font: 600 .85rem var(--sans); }
  .coll-tl-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .cell.lab:has(.sgw.on) { z-index: 5; }
  .tl { display: block; font: .78rem/1.3 var(--sans); color: var(--ink-2); letter-spacing: .01em; margin: 0; }
  .coll.tl-off .tl { display: none; }
  .coll-tl { margin: .1rem 0 0; }
  .form + .tl { margin: .05rem 0 .1rem; }
  .cell.head .tl { font-size: .72rem; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cntr-dialog { width: min(100vw, 64rem); height: min(100dvh, 52rem); max-width: 100vw; max-height: 100dvh; padding: 0; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper); color: var(--ink); }
  .cntr-dialog::backdrop { background: rgb(0 0 0 / .55); }
  .cntr-dialog[open] { display: flex; flex-direction: column; }
  .cntr-bar { display: flex; gap: 1rem; align-items: center; padding: .5rem .75rem; border-bottom: 1px solid var(--rule); font-family: var(--sans); }
  .cntr-bar strong { margin-right: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cntr-close { font: inherit; padding: .4rem .9rem; min-height: 2.5rem; border-radius: 6px; border: 1px solid var(--rule); background: var(--paper-2); color: var(--ink); cursor: pointer; }
  .cntr-dialog iframe { flex: 1; width: 100%; border: 0; background: #fff; }
  .coll-toggle { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; overflow: hidden; font: 600 .85rem var(--sans); }
  .coll-toggle[hidden] { display: none; }
  .coll-toggle button { border: 0; background: var(--paper); color: var(--ink); padding: .4rem .9rem; cursor: pointer; font: inherit; min-height: 2.25rem; }
  .coll-toggle button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .coll-key { display: flex; flex-wrap: wrap; gap: .3rem .9rem; margin: .6rem 0 1rem; font-family: var(--sans); color: var(--ink-2); }
  .coll-key span { display: inline-flex; gap: .3rem; align-items: center; }
  .sw { display: inline-block; width: 1rem; height: .85rem; border-radius: 3px; }
  .coll:not(.js) .coll-view + .coll-view { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--rule); }
  .g { font-family: var(--serif); }
  .ns { text-decoration: overline; text-decoration-thickness: 1px; }
  .dmg { text-decoration: underline dotted; }
  .miss { color: var(--ink-2); }
  .sp { color: var(--ink-2); }
  .sub { background: var(--coll-sub); border-radius: 3px; box-shadow: inset 0 -2px 0 var(--ochre); padding: 0 .1em; }
  .add { background: var(--coll-add); border-radius: 3px; box-shadow: inset 0 -2px 0 var(--lapis); padding: 0 .1em; }
  .tr { box-shadow: inset 0 -2px 0 var(--verdigris); border-radius: 3px; padding: 0 .1em; }
  .om { color: var(--ink-2); font: .85rem var(--sans); }
  .gl { font: italic .75rem/1.2 var(--sans); color: var(--ink-2); }
  .sg { font-family: var(--sigla); color: var(--rubric); }
  /* by reading */
  .coll-base { font-size: 1.25rem; line-height: 1.75; margin: 0; }
  .coll-base mark { background: var(--coll-sub); color: inherit; border-radius: 3px; padding: 0 .12em; box-shadow: inset 0 -2px 0 var(--ochre); }
  .coll-eng { font: italic .85rem var(--sans); color: var(--ink-2); margin: .2rem 0 1rem; }
  .units { display: grid; gap: .9rem; }
  .unit { border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; }
  .unit h4 { margin: 0; padding: .5rem .9rem; background: var(--paper-2); font: 600 .9rem var(--sans); }
  .unit h4 .g { font: 1.05rem var(--serif); }
  .un { display: inline-grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 1.5px solid var(--rubric); color: var(--rubric); font-size: .75rem; margin-right: .2rem; }
  .rds { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1px; background: var(--rule); }
  .rd { padding: .7rem .9rem; background: var(--paper); }
  .form { font-size: 1.25rem; margin: 0; }
  .eng { font: .85rem var(--sans); color: var(--ink-2); margin: .1rem 0 .5rem; }
  .ubs { margin-left: .4rem; padding: 0 .45rem; border: 1px solid var(--rubric); color: var(--rubric); border-radius: 999px; font: 600 .7rem/1.5 var(--sans); }
  .wits { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; }
  .wits li { display: inline-flex; gap: .4rem; align-items: baseline; padding: .15rem .6rem; border: 1px solid var(--rule); border-radius: 999px; font: .8rem var(--sans); }
  .wits :global(.sg) { font-size: 1rem; }
  .dt { color: var(--ink-2); }
  /* word by word */
  /* Phrases flow side by side and wrap to the next line, like text. */
  .coll-view[data-v="grid"]:not([hidden]) { display: flex; flex-wrap: wrap; gap: .9rem; align-items: flex-start; }
  .blk { display: grid; max-width: 100%; grid-template-columns: minmax(4.25rem, max-content) repeat(var(--cols), max-content); overflow-x: auto; border: 1px solid var(--rule); border-radius: 10px; }
  .row { display: contents; }
  .cell { padding: .3rem .55rem; border-bottom: 1px solid var(--rule); white-space: nowrap; line-height: 1.55; }
  .row:last-child .cell { border-bottom: 0; }
  .cell.head { display: flex; flex-direction: column; justify-content: flex-end; border-bottom: 2px solid var(--ink); }
  .cell.head.var { background: var(--coll-sub); }
  .cell.lab { position: sticky; left: 0; z-index: 1; background: var(--paper-2); border-right: 1px solid var(--rule); }
  .cell.lab :global(.sg) { font-size: 1.05rem; }
  .hb { font-weight: 600; }
  .cell.g { font-size: 1.05rem; }
  .eds { margin: .45rem 0 0; font: .8rem var(--sans); color: var(--ink-2); }
