---
// A worked example as a question card: the passage, the question it answers, and what it teaches.
import type { GuideMeta } from '../data/guides';
import { url } from '../lib/url';
interface Props { ex: GuideMeta; steps?: boolean; label?: string }
const { ex, steps = false, label } = Astro.props;
const STEPS = ['Find the problem', 'List the readings', 'External evidence', 'Internal evidence', 'Weigh it up', 'Decide'];
---
<a class="excard" href={url(ex.path)}>
  {label && <span class="exlabel">{label}</span>}
  <span class="exref">{ex.cover}</span>
  <span class="exq">{ex.question ?? ex.summary}</span>
  {ex.skill && <span class="exskill">{ex.skill}</span>}
  {steps && <ol class="exsteps" aria-label="Six steps">{STEPS.map((s) => <li>{s}</li>)}</ol>}
  <span class="exgo">Work through it →</span>
</a>
<style>
  .excard {
    display: flex; flex-direction: column; gap: 0.45rem; height: 100%; box-sizing: border-box;
    padding: 1rem 1.1rem; border: 1px solid var(--rule); border-left: 4px solid var(--verdigris);
    border-radius: 10px; background: var(--paper); color: var(--ink); text-decoration: none;
  }
  .excard:hover, .excard:focus-visible { border-color: var(--ink-2); border-left-color: var(--verdigris); }
  .excard:hover .exq { text-decoration: underline; text-decoration-thickness: 1px; }
  .exlabel { font: 600 0.7rem var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  .exref { font: 600 0.78rem var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--rubric); }
  .exq { font: 600 1.2rem/1.3 var(--serif); text-wrap: balance; }
  .exskill { font: 0.85rem/1.4 var(--sans); color: var(--ink-2); }
  .exsteps { list-style: none; counter-reset: s; display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; margin: 0.15rem 0 0; padding: 0; font: 0.75rem var(--sans); color: var(--ink-2); }
  .exsteps li { counter-increment: s; }
  .exsteps li::before { content: counter(s) " "; color: var(--rubric); font-weight: 700; }
  .exgo { margin-top: auto; padding-top: 0.25rem; font: 600 0.85rem var(--sans); color: var(--rubric); }
</style>
