---
// One step of a micro module. The body goes in the slot (text, a comparison, an MMQuestion).
interface Props { n: number; title: string; last?: boolean }
const { n, title, last = false } = Astro.props;
---
<section class="mm-step" data-title={title} aria-labelledby={`mm-s${n}`}>
  <p class="mm-n">Step {n}</p>
  <h2 id={`mm-s${n}`} tabindex="-1">{title}</h2>
  <slot />
  <button type="button" class="mm-next">{last ? 'Finish' : 'Next step →'}</button>
</section>

<style>
  .mm-step { margin: 2rem 0 0; padding-left: 1.1rem; border-left: 2px solid var(--rule); }
  .mm-step[hidden] { display: none; }
  .mm-n { margin: 0; font: 600 .72rem var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--rubric); }
  .mm-step h2 { margin: .1rem 0 .6rem; }
  .mm-next { font: 600 .95rem var(--sans); padding: .5rem 1.1rem; border-radius: 8px; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; min-height: 2.5rem; margin-top: .25rem; }
  .mm-next[hidden] { display: none; }
  :global(.mm:not(.js)) .mm-next { display: none; }
</style>
