---
// Specimen tile for one witness: the site's own page photo when there is one (ADR 0005),
// otherwise a texture by material with the siglum set large.
// Thumbnails come from scripts/make-thumbs.mjs (public/img/ms/thumb/).
import type { CollectionEntry } from 'astro:content';
import CoverageBar from './CoverageBar.astro';
import { coverage } from '../lib/coverage';
import { url } from '../lib/url';
interface Props { w: CollectionEntry<'witnesses'>['data']; link?: boolean }
const { w, link = true } = Astro.props;

const g = w.greek_ms;
const kindLabel = g ? g.category : ({ group: 'text group', version: 'version', father: 'church father', ot_ms: 'OT manuscript', greek_ms: '' } as const)[w.kind];
const material = g?.material?.value ?? (g?.category === 'papyrus' ? 'papyrus' : g ? 'parchment' : undefined);
const texture = material === 'papyrus' ? 'papyrus' : material === 'parchment' ? 'parchment' : 'plain';
const photo = w.page_image?.file && !w.page_image.withheld ? w.page_image : undefined;
const cov = w.kind === 'group' ? { e: 'on', a: 'on', p: 'on', c: 'on', r: 'on' } as const : coverage(g?.contents);
// A line of capitals for the texture; per-witness text can come later from a `specimen` field.
const scr = 'ΚΑΙΕΓΕΝΕΤΟΕΝΤΑΙΣΗΜΕΡΑΙΣ';
const Tag = link ? 'a' : 'div';
// Search text for the gallery filter: siglum, GA number, names and aliases, folded like lib/sigla toKey.
const fold = (x: string) => x.normalize('NFKC').toLowerCase();
const search = [w.siglum, g?.ga, ...w.names, ...w.aliases].filter(Boolean).map((x) => fold(x!)).join(' | ');
---
<Tag class="tile" href={link ? url(`w/${w.id}/`) : undefined}
  data-kind={g?.category ?? w.kind} data-search={search} data-from={w.date?.from} data-groups={cov ? Object.entries(cov).filter(([, v]) => v !== 'off').map(([k]) => k).join(' ') : ''}>
  <div class:list={['tile-spec', photo ? 'photo' : texture]}>
    {photo ? (
      <img src={url(photo.file!.replace('img/ms/', 'img/ms/thumb/'))} alt="" width="480" height="360" loading="lazy" decoding="async" />
    ) : (
      <>
        <span class="scr" aria-hidden="true">{scr.repeat(2)}</span>
        <span class="scr" aria-hidden="true">{[...scr].reverse().join('').repeat(2)}</span>
      </>
    )}
    <span class="sg" lang={w.siglum_lang} dir={w.siglum_lang === 'he' ? 'ltr' : undefined}>{w.siglum}</span>
  </div>
  <div class="tile-meta">
    <b>{w.names[0]}</b>
    <span class="ln"><span>{w.date?.label ?? ''}</span><span>{kindLabel}{g && !/^P/.test(g.ga) ? ` · ${g.ga}` : ''}</span></span>
    {cov && <CoverageBar cov={cov} />}
  </div>
</Tag>
