---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
const pages = [
  ['background/nt-text/', 'How we got the New Testament text', 'From lost originals to the UBS and ECM editions, and why the old "text-types" are debated.'],
  ['background/ot-text/', 'How we got the Old Testament text', 'The Masoretic Text, the Dead Sea Scrolls, the Septuagint, and how BHS and BHQ cite them.'],
  ['background/materials/', 'Materials and making', 'Papyrus and parchment, scrolls and books, scripts, nomina sacra, and the mistakes copyists made.'],
  ['guide/apparatus/', 'How to read a UBS apparatus entry', 'John 1:18, taken apart piece by piece.'],
];
---
<Base title="Background" nav="background/">
  <div class="prose bg">
    <h1>Background</h1>
    <p class="muted">Short pages on where the text came from, written for translators, not historians.</p>
    <ul class="results">
      {pages.map(([p, t, d]) => <li><a href={url(p)}><span class="r-name"><strong>{t}</strong><br /><span class="muted small">{d}</span></span></a></li>)}
    </ul>
  </div>
</Base>
<style>.bg { margin-top: 1.5rem; }</style>
