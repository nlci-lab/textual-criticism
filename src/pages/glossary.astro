---
import Base from '../layouts/Base.astro';
import { GLOSSARY } from '../data/glossary';
---
<Base title="Glossary" nav="glossary/">
  <div class="prose">
    <h1 class="page-h1">Glossary</h1>
    <p class="muted">Terms used on this site, in plain English: the symbols and short words of the UBS apparatus, and words for manuscripts and how they were made. Each entry gives its source. More entries will be added as profiles are written.</p>
    <dl class="gloss">
      {GLOSSARY.map((t) => (
        <div id={t.id}>
          <dt><span class="siglum">{t.term}</span></dt>
          <dd>{t.plain} <span class="small muted">Source: {t.source}.</span>{!t.checked && <span class="tag">not yet checked</span>}</dd>
        </div>
      ))}
    </dl>
  </div>
</Base>
<style>
  .page-h1 { margin-top: 1.5rem; }
  .gloss { margin: 1.5rem 0 0; }
  .gloss div { display: grid; grid-template-columns: minmax(5.5rem, auto) 1fr; gap: 1rem; padding: 0.75rem 0; border-top: 1px solid var(--rule); scroll-margin-top: 1rem; }
  .gloss div:target { background: var(--paper-2); }
  .gloss dt .siglum { font-size: 1.1rem; white-space: normal; }
  .gloss dd { margin: 0; }
  @media (max-width: 26rem) { .gloss div { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
