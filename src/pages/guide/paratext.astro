const sources = [
  { cite: 'Paratext 9 Help, "What is the meaning of the abbreviations used in the apparatuses?" (gives the UBS5 Master List of Symbols and Abbreviations, Introduction pp. 58*–63*).', checked: true },
  { cite: 'Paratext 9 Help, "Guide: Paratext > Download/Install resources".', checked: true },
  { cite: 'Paratext 9 Help, "What is a Source Language Text?", "How do I view a Source Language Text?", "How do I open a Source Language Text?", "How do I display interlinear lines in a Source Language Text?" and "What do the superscript characters in a Source Text mean?".', checked: true },
  { cite: 'Paratext 9.5 screens seen on 20 Nov 2026: the Source Language Text list (HEB/GRK, LXX/GRK, OHEB/OGRK), the Source Language Texts tab of Download/Install resources, and the apparatus popup at John 1:3-4.', checked: true },
  { cite: 'Paratext 9 Help, "What is a Text Collection?", "How do I open a Text Collection?", "How do I change the view in a Text Collection?" and "How do I see footnotes in a Text Collection?".', checked: true },
