---
import Base from '../layouts/Base.astro';
import { aliasIndex, allWitnesses } from '../lib/witnesses';
import { url } from '../lib/url';
const index = await aliasIndex();
const keys = Object.fromEntries([...index].map(([k, v]) => [k, v.map((e) => e.id)]));
const ws = (await allWitnesses()).map((w) => ({ id: w.id, s: w.siglum, n: w.names[0] + (w.siglum_scope ? ` (${w.siglum_scope})` : ''), l: w.siglum_lang ?? '' }));
---
<Base title="Textual Criticism" nav="">
  <div class="home prose">
    <h1>Textual Criticism</h1>
    <p class="intro">An introduction for Bible translators and consultants. Both Testaments come to us in handwritten copies, and the copies differ. Here you can learn how those differences arose, how the printed editions report them, and how to weigh them in your work.</p>
    <p class="muted small scope">The New Testament pages are the fullest so far. Old Testament pages are being added.</p>
    <nav class="paths" aria-label="Where to start">
      <a href={url('guide/apparatus/')}><strong>Read an apparatus entry</strong><span>John 1:18, piece by piece</span></a>
      <a href={url('guide/which-variants-matter/')}><strong>Which variants matter</strong><span>Not all differences weigh the same</span></a>
      <a href={url('background/nt-text/')}><strong>How we got the New Testament</strong><span>From copies to printed editions</span></a>
      <a href={url('background/ot-text/')}><strong>How we got the Old Testament</strong><span>The Masoretic Text, the scrolls, the Septuagint</span></a>
    </nav>
    <h2 class="lookup-h">Look up a witness</h2>
    <p class="muted">New Testament witnesses: type a siglum as you see it in the Paratext UBS apparatus, or paste a run of them.</p>
    <form class="search" id="lookup" action={url('witnesses/')} role="search">
      <label class="label" for="q">Siglum, GA number or name</label>
      <input id="q" name="q" type="search" autocomplete="off" autocapitalize="off" spellcheck="false"
        placeholder="𝔓66, א, B, 05, Byz" aria-describedby="q-help" aria-controls="results" />
      <div class="keys" role="group" aria-label="Insert a special character">
        <button type="button" data-ch="א" lang="he" aria-label="Insert aleph">א</button>
        <button type="button" data-ch="𝔓" aria-label="Insert papyrus P">𝔓</button>
        <button type="button" data-ch="ƒ" aria-label="Insert family f">ƒ</button>
        <button type="button" data-ch="ℓ" aria-label="Insert lectionary l">ℓ</button>
      </div>
      <p id="q-help" class="small muted">Press Enter to open the first match. Marks like <span class="siglum">*</span>, <span class="siglum">²</span> or <span class="siglum">vid</span> lead to the same witness.</p>
      <ul class="results" id="results" aria-live="polite"></ul>
    </form>
    <noscript><p>Search needs JavaScript. Use the <a href={url('witnesses/')}>list of all witnesses</a>, or go straight to an address like <code>{url('p66/')}</code>.</p></noscript>
    <p class="more-links">More: <a href={url('guide/')}>all guides</a> · <a href={url('background/')}>background</a> · <a href={url('witnesses/')}>all witnesses</a> · <a href={url('glossary/')}>glossary</a></p>
  </div>
  <script type="application/json" id="alias-data" set:html={JSON.stringify({ keys, ws })}></script>
</Base>

<script>
  import { candidateKeys, splitRun, toKey } from '../lib/sigla';
  type W = { id: string; s: string; n: string; l: string };
  const { keys, ws } = JSON.parse(document.getElementById('alias-data')!.textContent!) as { keys: Record<string, string[]>; ws: W[] };
  const byId = new Map(ws.map((w) => [w.id, w]));
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const q = document.getElementById('q') as HTMLInputElement;
  const out = document.getElementById('results')!;

  const resolve = (term: string): string[] => candidateKeys(term).map((k) => keys[k]).find(Boolean) ?? [];

  function search(text: string): W[] {
    const seen = new Set<string>();
    const hits: W[] = [];
    const add = (ids: string[]) => { for (const id of ids) if (!seen.has(id)) { seen.add(id); hits.push(byId.get(id)!); } };
    add(resolve(text));                                   // exact siglum or name first
    const parts = splitRun(text);
    if (parts.length > 1) parts.forEach((p) => add(resolve(p)));
    const k = toKey(text).toLowerCase();                  // then prefix matches on any alias
    // Single-letter sigla are case-sensitive (B is not b), so they only match exactly, never by prefix.
    if (k) for (const [alias, id] of Object.entries(keys)) if ([...alias].length > 1 && alias.toLowerCase().startsWith(k)) add(id);
    return hits.slice(0, 12);
  }

  function show() {
    const text = q.value.trim();
    const hits = text ? search(text) : [];
    out.replaceChildren(...hits.map((w) => {
      const li = document.createElement('li'), a = document.createElement('a');
      const s = document.createElement('span'), n = document.createElement('span');
      a.href = `${base}w/${w.id}/`;
      s.className = 'siglum'; s.textContent = w.s; if (w.l) s.lang = w.l;
      n.className = 'r-name'; n.textContent = w.n;
      a.append(s, n); li.append(a); return li;
    }));
    if (text && !hits.length) {
      const li = document.createElement('li');
      li.className = 'small muted';
      li.textContent = 'No witness found. Only five sample profiles exist so far.';
      out.append(li);
    }
  }

  q.addEventListener('input', show);
  document.getElementById('lookup')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const first = out.querySelector('a');
    if (first) location.href = first.href;
  });
  document.querySelectorAll<HTMLButtonElement>('.keys button').forEach((b) => b.addEventListener('click', () => {
    const ch = b.dataset.ch!, s = q.selectionStart ?? q.value.length, e = q.selectionEnd ?? s;
    q.value = q.value.slice(0, s) + ch + q.value.slice(e);
    q.focus(); q.setSelectionRange(s + ch.length, s + ch.length); show();
  }));
  const pre = new URLSearchParams(location.search).get('q');
  if (pre) { q.value = pre; show(); }
</script>

<style>
  .intro { font-size: var(--step-1); line-height: 1.5; margin: 0.5rem 0 1.25rem; }
  .paths { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); margin: 0 0 2rem; }
  .paths a { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.8rem 0.9rem; border-radius: 10px; background: var(--paper-2); box-shadow: 0 0 0 1px var(--rule); text-decoration: none; color: var(--ink); }
  .paths a:hover, .paths a:focus-visible { box-shadow: 0 0 0 1px var(--rubric); }
  .paths strong { font-family: var(--serif); font-size: 1.05rem; color: var(--rubric); }
  .paths span { font: 0.8125rem/1.4 var(--sans); color: var(--ink-2); }
  .lookup-h { margin-top: 0; }
  .scope { margin: -0.5rem 0 1.25rem; }
  .more-links { margin-top: 1.5rem; font-family: var(--sans); font-size: var(--step--1); }
</style>
