---
// Learn: the site's online course (in preparation) and the micro modules.
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { MODULES } from '../../data/modules';
import { url } from '../../lib/url';
---
<Base title="Learn" nav="learn/" description="Learn textual criticism step by step: an online course and short guided problems on single passages.">
  <div class="lx">
    <header class="lx-head">
      <p class="label">Learn</p>
      <h1>Learn textual criticism step by step</h1>
      <p class="muted">The guides explain the method and the worked examples show it in use. Here you practise it yourself.</p>
    </header>

    <section class="sec" id="course">
      <header><h2>Online course</h2></header>
      <div class="course">
        <Cover title="Introduction to Textual Criticism" kicker="Online course" pigment="gall" ornament="𝔓" />
        <div>
          <p class="label">In preparation</p>
          <p class="lead">A free, self-paced course for Bible translators and consultants who meet the UBS apparatus in their work: from why the manuscripts differ, to reading an entry, weighing the evidence and writing a footnote.</p>
          <p class="muted">The lessons will be added here. Until then, start with the <a href={url('guide/apparatus/')}>apparatus guide</a> and the <a href={url('guide/examples/')}>worked examples</a>.</p>
        </div>
      </div>
    </section>

    <section class="sec" id="modules">
      <header><h2>Micro modules</h2><span class="small muted">About ten minutes each</span></header>
      <p class="muted intro">Short guided problems on one passage. At every step you answer a question and see why.</p>
      <ul class="mods">
        {MODULES.map((m) => (
          <li><a class="mod" href={url(m.href)}>
            <span class="ref">{m.ref}</span><span class="q">{m.q}</span><span class="sk">{m.skill}</span>
            <span class="mn">About {m.minutes} minutes · {m.steps} steps</span>
          </a></li>
        ))}
      </ul>
    </section>

    <section class="sec">
      <header><h2>Also useful</h2></header>
      <ul class="also">
        <li><a href={url('guide/examples/')}>Worked examples</a>: the six steps on real verses.</li>
        <li><a href={url('guide/doubtful-passages/')}>Doubtful passages</a>: the passages most often questioned, grouped by type.</li>
        <li><a href={url('glossary/')}>Glossary</a>: the signs and terms of the apparatus.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .lx { margin: 1.75rem 0 3rem; }
  .lx-head p { max-width: var(--measure); }
  .course { display: grid; gap: 1.5rem; align-items: start; }
  .course :global(.cover) { width: 11rem; }
  @media (min-width: 700px) { .course { grid-template-columns: 12rem minmax(0, 1fr); max-width: 52rem; } .course :global(.cover) { width: 100%; } }
  .course .lead { font-size: 1.1rem; line-height: 1.5; }
  .intro { margin: -.25rem 0 1rem; max-width: var(--measure); }
  .mods { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .mod { display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: 1rem 1.1rem; border: 1px solid var(--rule); border-left: 4px solid var(--rubric); border-radius: 10px; color: var(--ink); text-decoration: none; background: var(--paper); }
  .mod:hover { border-color: var(--ink-2); border-left-color: var(--rubric); }
  .mod:hover .q { text-decoration: underline; text-decoration-thickness: 1px; }
  .ref { font: 600 .78rem var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--rubric); }
  .q { font: 600 1.2rem/1.3 var(--serif); }
  .sk { font: .85rem var(--sans); color: var(--ink-2); }
  .mn { margin-top: auto; font: 600 .8rem var(--sans); color: var(--ink-2); }
  .also { padding-left: 1.2rem; max-width: var(--measure); }
  .also li { margin-bottom: .4rem; }
</style>
